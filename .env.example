# Backend (prefix REPFUEL_) - copy to .env at the repo root
REPFUEL_POSE_MODEL=full            # lite | full | heavy (heavy must be downloaded: scripts/download_models.py heavy)
REPFUEL_MAX_UPLOAD_MB=300
REPFUEL_MAX_VIDEO_SECONDS=600
REPFUEL_INFERENCE_MAX_SIDE=640     # frames are downscaled to this for the pose model; annotation stays full-res
REPFUEL_FRAME_STRIDE=1             # run pose every Nth frame (overlay reuses the last result)
REPFUEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPFUEL_WORKER_THREADS=1

# Frontend (set in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
